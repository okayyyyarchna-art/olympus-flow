FROM public.ecr.aws/d3j8x8q7/olympus-base-go:latest
WORKDIR /app
COPY . .
ENV GOFLAGS="-buildvcs=false"
RUN go mod download && go list -m all > /dev/null && go build ./... && go vet ./... > /dev/null
RUN chmod -R a+rwX /app /opt/go && ln -sf /opt/go/bin/go-junit-report /usr/local/bin/go-junit-report
CMD ["/bin/bash"]
